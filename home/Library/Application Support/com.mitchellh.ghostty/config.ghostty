# Managed by dotfiles. Reload from Ghostty after edits.

# Match the current iTerm2 profile as closely as Ghostty allows.
font-family = MesloLGS NF
font-style = bold
font-size = 14
term = xterm-256color

background = #1d262a
foreground = #e7ebed
selection-background = #4e6a78
selection-foreground = #e7ebed
cursor-color = #70ffdf
cursor-text = #000000
cursor-style = block
cursor-style-blink = true

palette = 0=#435b67
palette = 1=#fc3841
palette = 2=#5cf19e
palette = 3=#fed032
palette = 4=#37b6ff
palette = 5=#fc226e
palette = 6=#59ffd1
palette = 7=#ffffff
palette = 8=#a1b0b8
palette = 9=#fc746d
palette = 10=#adf7be
palette = 11=#fee16c
palette = 12=#70cfff
palette = 13=#fc669b
palette = 14=#9affe6
palette = 15=#ffffff

scrollback-limit = 10000000
copy-on-select = clipboard
selection-clear-on-copy = false
confirm-close-surface = false

# shell
shell-integration = zsh
shell-integration-features = no-cursor,no-sudo,no-ssh-env,no-ssh-terminfo,path

# window
window-padding-x = 0
window-padding-y = 0

background-opacity = 0.93
background-blur = true
unfocused-split-opacity = 1.0

# macOS
macos-icon = retro
macos-window-buttons = hidden
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden

tab-inherit-working-directory = true
split-inherit-working-directory = true

# mouse
mouse-hide-while-typing = true
right-click-action = copy-or-paste

# keybinds
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
