xcode-sync() {
  local dotfiles_dir="$HOME/.dotfiles"
  local xcode_userdata="$HOME/Library/Developer/Xcode/UserData"
  local dotfiles_xcode="$dotfiles_dir/home/Library/Developer/Xcode/UserData"
  local docs_dir="$dotfiles_dir/docs"

  if [[ ! -d "$dotfiles_dir" ]]; then
    echo "Dotfiles directory not found: $dotfiles_dir"
    return 1
  fi

  mkdir -p \
    "$dotfiles_xcode/CodeSnippets" \
    "$dotfiles_xcode/KeyBindings" \
    "$dotfiles_xcode/FontAndColorThemes" \
    "$docs_dir"

  _xcode_sync_dir "$xcode_userdata/CodeSnippets" "$dotfiles_xcode/CodeSnippets" "*.codesnippet"
  _xcode_sync_dir "$xcode_userdata/KeyBindings" "$dotfiles_xcode/KeyBindings" "*.idekeybindings"
  _xcode_sync_dir "$xcode_userdata/FontAndColorThemes" "$dotfiles_xcode/FontAndColorThemes" "*.xccolortheme"
  _xcode_sync_docs "$dotfiles_xcode/CodeSnippets" "$docs_dir/xcode-snippets.md"

  (
    cd "$dotfiles_dir" || exit 1
    git status --short home/Library/Developer/Xcode/UserData docs/xcode-snippets.md
  )
}

_xcode_sync_dir() {
  local source_dir="$1"
  local target_dir="$2"
  local pattern="$3"
  local changed=false

  if [[ ! -d "$source_dir" ]]; then
    echo "Missing source directory: $source_dir"
    return 0
  fi

  mkdir -p "$target_dir"

  local source_file
  for source_file in "$source_dir"/${~pattern}(N); do
    local name="${source_file:t}"
    local target_file="$target_dir/$name"

    if [[ ! -f "$target_file" ]] || ! diff -q "$source_file" "$target_file" >/dev/null 2>&1; then
      cp "$source_file" "$target_file"
      echo "Updated $name"
      changed=true
    fi
  done

  local target_file
  for target_file in "$target_dir"/${~pattern}(N); do
    local name="${target_file:t}"
    if [[ ! -f "$source_dir/$name" ]]; then
      rm "$target_file"
      echo "Removed $name"
      changed=true
    fi
  done

  if [[ "$changed" == false ]]; then
    echo "No changes in ${target_dir:t}"
  fi
}

_xcode_sync_docs() {
  local snippets_dir="$1"
  local doc_path="$2"

  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 not found; skipped snippet docs"
    return 0
  fi

  SNIPPETS_DIR="$snippets_dir" DOC_PATH="$doc_path" python3 <<'PY'
import html
import os
import plistlib

snippets_dir = os.environ["SNIPPETS_DIR"]
doc_path = os.environ["DOC_PATH"]

snippets = []
for filename in sorted(os.listdir(snippets_dir)):
    if not filename.endswith(".codesnippet"):
        continue

    path = os.path.join(snippets_dir, filename)
    try:
        with open(path, "rb") as file:
            plist = plistlib.load(file)
    except Exception as error:
        print(f"Skipped {filename}: {error}")
        continue

    language = plist.get("IDECodeSnippetLanguage", "Unknown")
    if "." in language:
        language = language.split(".")[-1]

    snippets.append({
        "title": plist.get("IDECodeSnippetTitle", "Untitled"),
        "prefix": plist.get("IDECodeSnippetCompletionPrefix", ""),
        "language": language,
        "contents": html.unescape(plist.get("IDECodeSnippetContents", "")),
        "summary": plist.get("IDECodeSnippetSummary", ""),
    })

with open(doc_path, "w") as file:
    file.write("# Xcode Code Snippets\n\n")
    file.write("Quick reference for custom Xcode code snippets stored in this repository.\n\n")

    for snippet in snippets:
        file.write(f"## {snippet['title']}\n\n")
        if snippet["prefix"]:
            file.write(f"- Shortcut: `{snippet['prefix']}`\n")
        file.write(f"- Language: `{snippet['language']}`\n")
        file.write(f"- Code: `{snippet['contents']}`\n")
        if snippet["summary"]:
            file.write(f"- Note: `{snippet['summary']}`\n")
        file.write("\n")

print("Updated docs/xcode-snippets.md")
PY
}
