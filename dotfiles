#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: ./dotfiles <command>

Commands:
  nix       Install/verify Nix
  xcode     Run Xcode setup helper
  vscode    Run VS Code sync helper

Use either command for rebuilds:
  ./rebuild.sh
  nix run .#rebuild

Use Nix directly for checks:
  nix run .#check
EOF
}

case "${1:-help}" in
  nix)
    exec bash "$DOTFILES_DIR/scripts/nix.sh"
    ;;
  xcode)
    shift
    exec "$DOTFILES_DIR/scripts/xcode.sh" "$@"
    ;;
  vscode)
    shift
    exec "$DOTFILES_DIR/scripts/vscode.sh" "$@"
    ;;
  --help|-h|help)
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
