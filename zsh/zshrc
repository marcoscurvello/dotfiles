ZSH_DOTENV_PROMPT=false
# ENABLE POWERLEVEL10K INSTANT PROMPT
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# OH-MY-ZSH
export ZSH="$HOME/.oh-my-zsh"

# HOMEBREW PREFIX DETECTION
if [[ -d "/opt/homebrew" ]]; then
  # Apple Silicon
  export HOMEBREW_PREFIX="/opt/homebrew"
elif [[ -d "/usr/local/Homebrew" ]]; then
  # Intel Mac
  export HOMEBREW_PREFIX="/usr/local"
else
  # Fallback
  export HOMEBREW_PREFIX="/usr/local"
fi

# PATH EXPORTS
export PATH="$HOMEBREW_PREFIX/bin:$HOME/bin:$HOME/.dotfiles/bin:/usr/local/sbin:$PATH"

# Add uv/uvx to PATH
export PATH="$HOME/.local/bin:$PATH"

# Add nodenv shims to PATH for consistent Node.js version
export PATH="$HOME/.nodenv/shims:$PATH"

# Add rbenv shims to PATH for consistent Ruby version
export PATH="$HOME/.rbenv/shims:$PATH"

# Add pyenv shims to PATH for consistent Python version
export PATH="$HOME/.pyenv/shims:$PATH"

# RBENV, NODENV & PYENV - Lazy loading for faster startup
rbenv() {
  unset -f rbenv
  eval "$(command rbenv init - --no-rehash)"
  rbenv "$@"
}

nodenv() {
  unset -f nodenv
  eval "$(command nodenv init - --no-rehash)"
  nodenv "$@"
}

pyenv() {
  unset -f pyenv
  eval "$(command pyenv init -)"
  pyenv "$@"
}

# CLAUDE - Direct execution since Node is in PATH
# Claude Code is installed globally via Homebrew npm

# ZSH THEME - Empty since we manually source powerlevel10k
ZSH_THEME=""

# ZSH PERFORMANCE
DISABLE_UPDATE_PROMPT=true
DISABLE_AUTO_UPDATE=true
COMPLETION_WAITING_DOTS=true

# ZSH PLUGINS
plugins=(
  git
  jsontools
  bundler
  dotenv
  macos
  ruby
)

# ENVIRONMENT CONFIGURATION
export LANG=en_US.UTF-8
export EDITOR='code'
export BROWSER='open'

# HISTORY CONFIGURATION
export HISTSIZE=10000
export SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE

# OH-MY-ZSH
source $ZSH/oh-my-zsh.sh

# MACOS-STYLE ZLE SELECTION
autoload -Uz select-word-style
select-word-style bash

_select_backward_char() {
  (( REGION_ACTIVE )) || zle set-mark-command
  zle backward-char
}
zle -N _select_backward_char

_select_forward_char() {
  (( REGION_ACTIVE )) || zle set-mark-command
  zle forward-char
}
zle -N _select_forward_char

_select_backward_word() {
  (( REGION_ACTIVE )) || zle set-mark-command
  zle backward-word
}
zle -N _select_backward_word

_select_forward_word() {
  (( REGION_ACTIVE )) || zle set-mark-command
  zle forward-word
}
zle -N _select_forward_word

_select_beginning_of_line() {
  (( REGION_ACTIVE )) || zle set-mark-command
  zle beginning-of-line
}
zle -N _select_beginning_of_line

_select_end_of_line() {
  (( REGION_ACTIVE )) || zle set-mark-command
  zle end-of-line
}
zle -N _select_end_of_line

_backward_delete_char_or_kill_region() {
  if (( REGION_ACTIVE )); then
    zle kill-region
  else
    zle backward-delete-char
  fi
}
zle -N _backward_delete_char_or_kill_region

_delete_char_or_kill_region() {
  if (( REGION_ACTIVE )); then
    zle kill-region
  else
    zle delete-char
  fi
}
zle -N _delete_char_or_kill_region

_backward_kill_word_or_kill_region() {
  if (( REGION_ACTIVE )); then
    zle kill-region
  else
    zle backward-kill-word
  fi
}
zle -N _backward_kill_word_or_kill_region

_kill_word_or_kill_region() {
  if (( REGION_ACTIVE )); then
    zle kill-region
  else
    zle kill-word
  fi
}
zle -N _kill_word_or_kill_region

_self_insert_or_kill_region() {
  (( REGION_ACTIVE )) && zle kill-region
  zle .self-insert
}
zle -N self-insert _self_insert_or_kill_region

_collapse_region_left() {
  if (( REGION_ACTIVE )); then
    (( CURSOR > MARK )) && CURSOR=$MARK
    zle deactivate-region
  else
    zle backward-char
  fi
}
zle -N _collapse_region_left

_collapse_region_right() {
  if (( REGION_ACTIVE )); then
    (( CURSOR < MARK )) && CURSOR=$MARK
    zle deactivate-region
  else
    zle forward-char
  fi
}
zle -N _collapse_region_right

_history_search_backward_or_deselect() {
  (( REGION_ACTIVE )) && zle deactivate-region
  zle history-search-backward
}
zle -N _history_search_backward_or_deselect

_history_search_forward_or_deselect() {
  (( REGION_ACTIVE )) && zle deactivate-region
  zle history-search-forward
}
zle -N _history_search_forward_or_deselect

bindkey '^A' beginning-of-line
bindkey '^E' end-of-line
bindkey '^U' backward-kill-line
bindkey '^K' kill-line

bindkey '\e[1;2D' _select_backward_char
bindkey '\e[1;2C' _select_forward_char
bindkey '\e[1;4D' _select_backward_word
bindkey '\e[1;4C' _select_forward_word
bindkey '\e[1;2H' _select_beginning_of_line
bindkey '\e[1;2F' _select_end_of_line

bindkey '\e[D' _collapse_region_left
bindkey '\e[C' _collapse_region_right
bindkey '\e[A' _history_search_backward_or_deselect
bindkey '\e[B' _history_search_forward_or_deselect
bindkey '\eOD' _collapse_region_left
bindkey '\eOC' _collapse_region_right
bindkey '\eOA' _history_search_backward_or_deselect
bindkey '\eOB' _history_search_forward_or_deselect

bindkey '^?' _backward_delete_char_or_kill_region
bindkey '^H' _backward_delete_char_or_kill_region
bindkey '\e[3~' _delete_char_or_kill_region
bindkey '\eb' backward-word
bindkey '\ef' forward-word
bindkey '\e[1;3D' backward-word
bindkey '\e[1;3C' forward-word
bindkey '\e[3;3D' backward-word
bindkey '\e[3;3C' forward-word
bindkey '\e^?' _backward_kill_word_or_kill_region
bindkey '\ed' _kill_word_or_kill_region

# CUSTOM FUNCTIONS
fpath=($HOME/.dotfiles/zsh/functions $fpath)
autoload -U $HOME/.dotfiles/zsh/functions/*(:t)

# Set personal aliases, overriding those provided by oh-my-`zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.

# CD
alias .="open ."
alias dot="cd ~/.dotfiles"
alias dev="cd ~/Developer"

# GIT
alias branch="git symbolic-ref --short HEAD | tr -d ' \n' | pbcopy"
alias origin="git remote -v | grep origin | head -n1 | awk '{print \$2}' | tee >(pbcopy)"
alias upstream="git remote -v | grep upstream | head -n1 | awk '{print \$2}' | tee >(pbcopy)"

# EZA (modern ls replacement)
alias ls="eza -la --group-directories-first"
alias ll="eza -la --group-directories-first --icons=always --git"
alias tree="eza --tree --level=2 --icons=always"

# BAT (modern cat replacement)
alias cat="bat --paging=never --theme=default"

# MODERN CLI TOOLS
alias find="fd"               # Better find
alias grep="rg"              # Better grep
alias top="htop"             # Better top
alias du="dust"              # Better du (if installed)
alias ps="procs"             # Better ps (if installed)

# DEVELOPMENT SHORTCUTS
alias code="code ."         # Open current directory in VS Code
alias serve="python3 -m http.server 8000"  # Quick HTTP server

# PRIVATE
[[ -f ~/.zsh_private_aliases ]] && source ~/.zsh_private_aliases

# FZF CONFIGURATION
if command -v fzf &> /dev/null; then
  # Use ripgrep for fzf if available
  if command -v rg &> /dev/null; then
    export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git/*"'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  fi

  # Enhanced fzf options
  export FZF_DEFAULT_OPTS='
    --height 40%
    --layout=reverse
    --border
    --preview "bat --style=numbers --color=always --line-range :500 {}"
    --color=bg+:#414559,bg:#303446,spinner:#f2d5cf,hl:#e78284
    --color=fg:#c6d0f5,header:#e78284,info:#ca9ee6,pointer:#f2d5cf
    --color=marker:#f2d5cf,fg+:#c6d0f5,prompt:#ca9ee6,hl+:#e78284'

  # Load fzf key bindings and completion
  [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
fi

# POWERLEVEL10K
source "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme"
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ZSH AUTOSUGGESTIONS
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# ZSH SYNTAX HIGHLIGHTING (must be last)
source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# CLAUDE TERMINAL WINDOW WRAPPER
[[ -f ~/.config/zsh/terminal-title-wrapper.zsh ]] && source ~/.config/zsh/terminal-title-wrapper.zsh
alias dotfiles="cd ~/.dotfiles && ./dotfiles"
