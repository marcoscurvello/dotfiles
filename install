#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"

if ! command -v nix >/dev/null 2>&1; then
  echo "Nix is required to activate these dotfiles." >&2
  echo "Run ./dotfiles nix first, then retry ./install." >&2
  exit 1
fi

exec nix --extra-experimental-features "nix-command flakes" run .#switch "$@"
