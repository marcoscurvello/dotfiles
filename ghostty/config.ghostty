# Managed by dotfiles. Reload from Ghostty after edits.

# Match the current iTerm2 profile as closely as Ghostty allows.
font-family = MesloLGS NF
font-style = bold
font-size = 14
term = xterm-256color

background = #1d262a
foreground = #e7ebed
selection-background = #4e6a78
selection-foreground = #e7ebed
cursor-color = #70ffdf
cursor-text = #000000
cursor-style = block
cursor-style-blink = true

palette = 0=#435b67
palette = 1=#fc3841
palette = 2=#5cf19e
palette = 3=#fed032
palette = 4=#37b6ff
palette = 5=#fc226e
palette = 6=#59ffd1
palette = 7=#ffffff
palette = 8=#a1b0b8
palette = 9=#fc746d
palette = 10=#adf7be
palette = 11=#fee16c
palette = 12=#70cfff
palette = 13=#fc669b
palette = 14=#9affe6
palette = 15=#ffffff

scrollback-limit = 10000000
copy-on-select = clipboard
selection-clear-on-copy = false
right-click-action = copy-or-paste
confirm-close-surface = false
shell-integration = detect
shell-integration-features = no-cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path

window-padding-x = 0
window-padding-y = 0
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

background-opacity = 1
background-blur = false
macos-option-as-alt = true
mouse-hide-while-typing = true

# Fill the gap between Ghostty defaults and your iTerm key mappings.
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05
keybind = cmd+backspace=text:\x15
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf
keybind = alt+backspace=esc:\x7f
keybind = alt+delete=esc:d

unfocused-split-opacity = 1.0
keybind = shift+left=text:\x1b[1;2D
keybind = shift+right=text:\x1b[1;2C
keybind = alt+shift+left=text:\x1b[1;4D
keybind = alt+shift+right=text:\x1b[1;4C
keybind = cmd+shift+left=text:\x1b[1;2H
keybind = cmd+shift+right=text:\x1b[1;2F
